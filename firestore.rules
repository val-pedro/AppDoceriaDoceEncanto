rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.category is string && (data.category in ['bolos', 'brigadeiros', 'finos', 'pote', 'especiais']) &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.unit is string && (data.unit in ['un', 'caixa', 'kg', 'fatia']) &&
             data.isOnline is bool;
    }

    function isValidNotification(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 250 &&
             data.isRead is bool &&
             data.type is string && (data.type in ['stock', 'order', 'info']);
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) && isValidProduct(incoming());
      allow update: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if isValidId(productId);
    }

    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create: if isValidId(notificationId) && isValidNotification(incoming());
      allow update: if isValidId(notificationId) && isValidNotification(incoming());
      allow delete: if isValidId(notificationId);
    }
  }
}
